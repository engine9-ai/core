# Deploy an @engine9/core site to Cloudflare from GitHub, with no terminal.
# Copy to .github/workflows/deploy.yml. docs/no-command-line.md explains it.
#
# Repository secrets (Settings, Secrets and variables, Actions):
#   CLOUDFLARE_API_TOKEN   a token from Cloudflare's "Edit Cloudflare Workers"
#                          template, plus Account, D1, Edit
#   CLOUDFLARE_ACCOUNT_ID  the account that owns the Worker and its D1 database
#   E9_SUPERADMINS         optional: comma-separated emails that act as admin
#                          (they open /api/admin/status in a browser)
# Repository variable (optional):
#   SITE_URL               https://www.example.com, when wrangler.jsonc has no
#                          single custom-domain route
#
# Every step is safe to re-run. Setup reads what production already has and
# adds only what is missing; it never replaces a key or a signing secret
# unless "rotate" is checked.

name: Deploy

on:
  push:
    branches: [main]
  workflow_dispatch:
    inputs:
      command:
        description: What runs after the deploy
        type: choice
        options: [upgrade, installDefaultPlugins]
        default: upgrade
      options:
        description: Extra flags for that command, such as --dry-run or --plugin <path>
        required: false
        default: ''
      rotate:
        description: Replace production's keys and signing secrets (everyone signed in signs in again)
        type: boolean
        default: false

concurrency:
  group: deploy
  cancel-in-progress: false

jobs:
  deploy:
    runs-on: ubuntu-latest
    env:
      CLOUDFLARE_API_TOKEN: ${{ secrets.CLOUDFLARE_API_TOKEN }}
      CLOUDFLARE_ACCOUNT_ID: ${{ secrets.CLOUDFLARE_ACCOUNT_ID }}
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-node@v4
        with:
          node-version: 22
          cache: npm

      - run: npm ci

      # Creates the D1 database and its tables when they are missing, and the
      # API keys, SESSION_SECRET and AGENT_CREDENTIALS_SECRET the Worker does
      # not have yet. A second run changes nothing.
      - name: Set up production
        env:
          ROTATE: ${{ inputs.rotate && '--rotate' || '' }}
        run: npx e9core setup --remote --no-deploy $ROTATE

      - name: Deploy
        env:
          E9_SUPERADMINS: ${{ secrets.E9_SUPERADMINS }}
        run: |
          if [ -n "$E9_SUPERADMINS" ]; then
            npx wrangler deploy --var "E9_SUPERADMINS:$E9_SUPERADMINS"
          else
            npx wrangler deploy
          fi

      # Upgrades the database to the deployed code, with an admin key that
      # exists only for this step (--remote). Retries while a new custom
      # domain comes up.
      - name: Upgrade the database
        env:
          COMMAND: ${{ inputs.command || 'upgrade' }}
          OPTIONS: ${{ inputs.options }}
          SITE_URL: ${{ vars.SITE_URL }}
        run: |
          for attempt in 1 2 3; do
            npx e9core "$COMMAND" --remote ${SITE_URL:+--url "$SITE_URL"} $OPTIONS && exit 0
            sleep 20
          done
          exit 1
